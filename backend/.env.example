# ---------------------------------------------------------------------------
# ReviewPulse Backend Configuration
# ---------------------------------------------------------------------------

APP_NAME=reviewpulse-api
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
LOG_LEVEL=INFO
AMAZON_CSV_PATH=

# Production Notes for Render Deployment:
# 1. Set APP_ENV=production
# 2. Set CORS_ORIGINS=https://<your-frontend-domain>.vercel.app
# 3. Render sets PORT automatically (default: 10000)
# 4. If using Render PostgreSQL, set DATABASE_URL to your Internal Database URL
